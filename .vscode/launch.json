{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Foreshadow Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension/**/*.js"
      ],
      "preLaunchTask": "pnpm: compile"
    },
    {
      "name": "Run Foreshadow Extension (watch)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/extension/**/*.js"
      ],
      "preLaunchTask": "pnpm: watch"
    }
  ]
}
